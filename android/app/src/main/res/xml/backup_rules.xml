<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android-12 (API < 31) full-backup rules — the legacy counterpart to
  data_extraction_rules.xml, referenced via android:fullBackupContent.

  See data_extraction_rules.xml for why these rules currently aren't reached
  (android:allowBackup="false" disables backup entirely) and are kept as
  defense-in-depth / documentation of intent.
-->
<full-backup-content>
    <exclude domain="sharedpref" />
    <exclude domain="database" />
    <exclude domain="file" />
</full-backup-content>
