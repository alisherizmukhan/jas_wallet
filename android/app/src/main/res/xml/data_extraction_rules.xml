<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup/transfer rules.

  android:allowBackup="false" on the <application> tag already disables all
  backup mechanisms (cloud auto-backup and `adb backup`) outright, so these
  rules are not currently reached. They are kept as defense-in-depth and
  documentation of intent: if allowBackup is ever re-enabled, no app data is
  eligible for cloud backup or device-to-device transfer until explicitly
  opted back in here. FlutterSecureStorage-backed data (tokens, PIN hash,
  SALTO digital key) is Android Keystore-encrypted and excluded from backup
  by the platform regardless; SharedPreferences is plain storage and must be
  excluded explicitly, since it holds the SALTO access log, device-identity
  UUID fallback flags, and other data that must never leave this device.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapability="false">
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
