<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- All production traffic must use HTTPS. Cleartext is blocked. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

    <!-- In debug builds, allow user-installed CAs (e.g. Charles Proxy). -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </debug-overrides>
</network-security-config>
